# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Allowed chat IDs separated by commas (leave empty to allow all)
ALLOWED_CHAT_IDS=

# Performance & Safety Limits
MAX_FILESIZE_BYTES=48000000
MAX_CONCURRENT_DOWNLOADS=2
MAX_QUEUE_SIZE=20
DOWNLOAD_TIMEOUT_SEC=180

# Optional proxy and cookies
PROXY_URL=
COOKIES_FILE=
